# Optional locally: if omitted, a persistent random key is generated in instance/session.key.
# SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Quick local demonstration (no MySQL setup required):
DATABASE_URL=sqlite:///servicedesk.db
# MySQL alternative (URL-encode special characters in the password):
# DATABASE_URL=mysql+pymysql://deskflow:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:3306/it_service_desk?charset=utf8mb4
# Set true only when serving over HTTPS:
COOKIE_SECURE=false
